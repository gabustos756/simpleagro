# Configuración de Entorno (EduAgro)
# Copia este archivo a .env y completa los valores correspondientes.

# Claves de APIs Externas
GOOGLE_API_KEY=tu_google_api_key_aqui
GOOGLE_MAPS_WEATHER_API_KEY=tu_google_maps_weather_api_key_opcional

# Configuración del Servicio Meteorológico Multiproveedor
WEATHER_PRIMARY_PROVIDER=google_weather
WEATHER_SECONDARY_PROVIDER=open_meteo
WEATHER_HTTP_TIMEOUT_SECONDS=5
WEATHER_HTTP_MAX_RETRIES=2
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_STALE_CACHE_MAX_AGE_MINUTES=60
WEATHER_ENABLE_PERSISTENCE=true
WEATHER_CONSENSUS_ENABLED=true
WEATHER_CONSERVATIVE_ON_DISAGREEMENT=true

# Base de Datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/eduagro

# Secreto de Sesión
SESSION_SECRET=tu_session_secret_secreto
